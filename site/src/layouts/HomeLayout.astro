---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1011" />
    <title>{title} · Executable Engineering Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="home-shell site-header">
      <a class="brand" href={base} aria-current="page">Executable Engineering Lab</a>
      <nav aria-label="Main navigation">
        <a href={`${base}learn/`}>Learn</a>
        <a href={`${base}lab/`}>Lab</a>
        <a href={`${base}reference/`}>Reference</a>
        <a href="https://github.com/And-Gu/executable-engineering-lab">Source</a>
      </nav>
    </header>
    <main class="home-shell" id="main" tabindex="-1"><slot /></main>
    <footer class="home-shell site-footer">
      The AI-assisted workflow above is conceptual. <a href={`${base}lab/`}>The working lab</a> is a single-sensor teaching model; broader demonstrations are in development.
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --home-bg: #0d1011;
    --home-panel: #151a1c;
    --home-text: #f1f3ef;
    --home-muted: #b9c2c5;
    --home-rule: #384144;
    --home-gold: #f1d67b;
    --home-teal: #9ed8cb;
    --home-mono: 'IBM Plex Mono', Menlo, Consolas, monospace;
    font-family: Inter, Arial, Helvetica, sans-serif;
    color: var(--home-text);
    background: var(--home-bg);
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
  }

  * { box-sizing: border-box; }
  body { margin: 0; }
  h1, h2, h3, p, figure { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--home-gold); text-decoration: underline; text-underline-offset: .3em; }
  :focus-visible { outline: 2px solid var(--home-gold); outline-offset: 5px; }
  ::selection { color: var(--home-bg); background: var(--home-gold); }
  .home-shell { width: min(89.6%, 70rem); margin-inline: auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
</style>

<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--home-rule); }
  .brand { border-left: 3px solid var(--home-gold); padding-left: .75rem; font-size: .875rem; font-weight: 700; letter-spacing: -.022rem; }
  nav { display: flex; flex-wrap: wrap; gap: .5rem 1.375rem; font: .6875rem/1.5 var(--home-mono); text-transform: uppercase; letter-spacing: .025rem; color: var(--home-muted); }
  nav a { padding-block: .25rem; }
  .site-footer { padding-block: 0 1.5rem; font-size: .6875rem; color: var(--home-muted); }
  .site-footer a { text-decoration: underline; text-underline-offset: .2em; }
  .skip { position: absolute; top: -5rem; left: 1rem; padding: .6rem 1rem; background: var(--home-panel); z-index: 1; }
  .skip:focus { top: .5rem; }
  @media (max-width: 500px) {
    .site-header { flex-direction: column; align-items: flex-start; gap: 1rem; padding-block: 1.25rem; }
    .brand { font-size: .8125rem; padding-left: .625rem; }
  }
</style>
