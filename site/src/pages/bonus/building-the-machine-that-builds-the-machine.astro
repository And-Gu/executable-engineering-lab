---
import Layout from '../../layouts/ResourceLayout.astro';
import { Content } from '../../../../project/v3/bonus/building-the-machine-that-builds-the-machine.md';
const base = import.meta.env.BASE_URL;
---
<Layout title="Building the Machine That Builds the Machine" section="Bonus · Trends & Perspectives"
  description="What a small documentation project can teach a team about investing in the tools, people and checks that build its product.">
  <article class="bonus-article"><Content /></article>
  <nav class="return-links" aria-label="Continue reading">
    <a href={base + 'learn/v3/13-continuously-integrated-engineering/'}>Chapter 13 · Continuously Integrated Engineering</a>
    <a href={base + 'learn/#bonus-reading'}>Learning path</a>
  </nav>
</Layout>
<style>
  .bonus-article { max-width: 74ch; font-size: clamp(1rem, 1.25vw, 1.12rem); line-height: 1.72; }
  .bonus-article :global(iframe) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border: 0; }
  .bonus-article :global(details) { padding: .45rem 1rem; margin-block: 1.4rem; background: var(--home-panel); border: 1px solid var(--home-rule); }
  .bonus-article :global(th), .bonus-article :global(td) { border-bottom: 1px solid var(--home-rule); padding: .7rem .5rem; text-align: left; vertical-align: top; }
  .bonus-article :global(table) { width: 100%; border-collapse: collapse; }
  .bonus-article :global(.companion-video) { margin: 1.6rem 0; }
  .bonus-article :global(.comparison-table) { overflow-x: auto; }
  .bonus-article :global(th) { min-width: 7rem; }
  .return-links { display: flex; flex-wrap: wrap; gap: .8rem 2rem; padding-top: 1.3rem; margin-top: 2.3rem; border-top: 1px solid var(--home-rule); }
</style>
