---
import Layout from '../../layouts/ResourceLayout.astro';
import { chapters, v2Chapters, chapterPreviews } from '../../data/chapters';
import CourseOverview from '../../components/CourseOverview.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Learning path" section="Learn" heading="Follow the intersection from intent to release"
  description="Start with what road users need, run an experiment, and follow the evidence a product team uses to make an engineering decision.">
  <CourseOverview />
  <section class="bonus-reading" id="bonus-reading" aria-labelledby="bonus-title">
    <h2 id="bonus-title">Bonus reading</h2>
    <h3><a href={base + 'bonus/building-the-machine-that-builds-the-machine/'}>Building the Machine That Builds the Machine</a></h3>
    <p>When does it pay to invest in the environment you use to engineer a product? Start with a small documentation project and follow the decision into an engineering team.</p>
  </section>
  <section aria-labelledby="course-language-title">
    <h2 id="course-language-title">The course vocabulary</h2>
    <p><a href={base + 'learn/v3/01-the-new-engineering-paradigm/'}>Chapter 1</a> introduces systems engineering, software-driven work and AI assistance. <a href={base + 'learn/v3/08-directing-ai-engineering-agents/'}>Chapter 8</a> shows how people direct agents that can use tools and check a result.</p>
  </section>
  <section class="earlier" aria-labelledby="earlier-title">
    <h2 id="earlier-title">Earlier courses and experiments</h2>
    <h3 id="reader-preview-title">Chapter 1 preview</h3>
    {chapterPreviews.map(c => <p><a href={base + 'learn/' + c.path + '/'}>{c.title}</a> · {c.summary}</p>)}
    <h3 id="published-v2">V2 articles</h3>
    {v2Chapters.map(c => <p><a href={base + 'learn/' + c.path + '/'}>{c.title}</a> · {c.summary}</p>)}
    <h3 id="published-lessons">Original single-sensor course</h3>
    <p>These earlier lessons are retained as historical reading; their sensor-based browser exercises have been retired.</p>
    <ol aria-label="Published lessons">{chapters.map(c => <li><a href={base + 'learn/' + c.path + '/'}>{c.title}</a></li>)}</ol>
  </section>
</Layout>
<style>
  .earlier, .bonus-reading { border-top: 1px solid var(--home-rule); margin-block: 3.25rem; }
  .bonus-reading h3 a { color: var(--home-teal); }
  .earlier ol { columns: 2 18rem; padding-inline-start: 1.5rem; max-width: 58rem; }
  .earlier li { padding: .3rem .5rem; break-inside: avoid; }
</style>
