---
import type { MarkdownInstance } from 'astro';
import { v3Chapters } from '../../../data/v3-course';
import { chapterQuizzes, chapterSections } from '../../../data/v3-learning';
import EngineeringCapabilityFlow from '../../../components/learning/EngineeringCapabilityFlow.astro';
import EvidenceHandoffs from '../../../components/learning/EvidenceHandoffs.astro';
import IntegratedChange from '../../../components/learning/IntegratedChange.astro';
import ReleaseReadiness from '../../../components/learning/ReleaseReadiness.astro';
import ChapterQuiz from '../../../components/learning/ChapterQuiz.astro';
import ChangeImpactFigure from '../../../components/learning/ChangeImpactFigure.astro';
import InvestmentFeedback from '../../../components/learning/InvestmentFeedback.astro';
import TwoCycleExperiment from '../../../components/learning/TwoCycleExperiment.astro';
import DigitalThread from '../../../components/learning/DigitalThread.astro';
import QueueExperiment from '../../../components/learning/QueueExperiment.astro';
import ArrivalPatterns from '../../../components/learning/ArrivalPatterns.astro';
import IntersectionStructure from '../../../components/learning/IntersectionStructure.astro';
import SocialLinks from '../../../components/SocialLinks.astro';
import AuthorAttribution from '../../../components/AuthorAttribution.astro';
import '../../../styles/chapter-reading.css';
import '../../../styles/v3-learning.css';
import { checkout } from '../../../../../scripts/delivery-environment.mjs';
export async function getStaticPaths() {
  const modules = import.meta.glob<MarkdownInstance<{id:string;chapter:number;title:string;part:string}>>('../../../../../project/v3/manuscripts/revised/[0-9]*.md', { eager: true });
  // Build pages only for the current course registry. Historical files with
  // superseded chapter numbers remain available as sources but are not routes.
  return v3Chapters.map(current => {
    const slug = current.url.split('/').filter(Boolean).at(-1);
    const chapter = Object.entries(modules).find(([path]) => path.endsWith(`/${slug}.md`))?.[1];
    if (!chapter || !slug) throw new Error(`Missing current V3 manuscript for ${current.title}`);
    if (Number(chapter.frontmatter.chapter) !== Number(current.number) || chapter.frontmatter.title !== current.title) {
      throw new Error(`V3 source does not match curriculum: ${slug}`);
    }
    return { params: { slug }, props: { chapter } };
  });
}
const { chapter } = Astro.props;
const { Content, frontmatter, getHeadings } = chapter;
const index = v3Chapters.findIndex(c => Number(c.number) === frontmatter.chapter);
const current = v3Chapters[index];
if (!current || current.title !== frontmatter.title) throw new Error('Manuscript and curriculum title mismatch');
const previous = v3Chapters[index - 1], next = v3Chapters[index + 1];
const base = import.meta.env.BASE_URL;
type Heading = { depth: number; slug: string; text: string };
const headings: Heading[] = getHeadings().filter((h: Heading) => h.depth === 2);
const questions = chapterQuizzes.get(frontmatter.id);
const activities = ['chapter-quiz'];
if (frontmatter.id === 'eel-v3-ch01-new-paradigm') activities.push('investment-feedback');
if (frontmatter.id === 'eel-v3-ch02-intersection-challenge') activities.push('arrival-patterns');
if (frontmatter.id === 'eel-v3-ch04-engineering-knowledge') activities.push('intersection-structure', 'change-impact-figure');
if (frontmatter.id === 'eel-v3-ch05-models-prototypes') activities.push('intersection-model');
if (frontmatter.id === 'eel-v3-ch06-engineering-data') activities.push('two-cycle-experiment');
if (frontmatter.id === 'eel-v3-ch09-reviewable-increments') activities.push('digital-thread');
if (frontmatter.id === 'eel-v3-ch11-verification-evidence') activities.push('integrated-change');
if (frontmatter.id === 'eel-v3-ch13-continuous-engineering') activities.push('release-readiness');
if (frontmatter.id === 'eel-v3-ch14-course-wrap-up') activities.push('engineering-capability-flow', 'evidence-handoffs');
const sections = questions
  ? chapterSections(await chapter.compiledContent(), activities)
  : [];
const contents = questions ? sections.flatMap(section => {
  if (section.kind === 'prose') return headings.filter(h => section.content.includes(`<h2 id="${h.slug}"`));
  if (section.content === 'intersection-model') return [{ depth: 2, slug: 'arrival-experiment', text: 'Move one arrival' }];
  return section.content === 'chapter-quiz' ? [{ depth: 2, slug: 'chapter-quiz', text: 'Check your understanding' }] : [];
}) : headings;
const sourceState = checkout();
const sourceUrl = `https://github.com/And-Gu/executable-engineering-lab/blob/${sourceState.dirty ? 'main' : sourceState.revision}/project/v3/manuscripts/revised/${Astro.params.slug}.md`;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={current.summary}/><title>{current.title} · Executable Engineering Lab</title></head>
<body>
<a class="skip" href="#main">Skip to chapter</a>
<header class="reading-shell site-header"><a class="brand" href={base}>Executable Engineering Lab</a><nav aria-label="Main navigation"><a href={base + 'learn/'}>Learn</a><a href={base + 'lab/'}>Lab</a><a href={base + 'reference/'}>Reference</a></nav><SocialLinks /></header>
<div class="reading-shell reading-grid">
<aside class="course-sidebar"><nav aria-label="Course chapters"><a href={base + 'learn/'}>All {v3Chapters.length} chapters</a><ol>{v3Chapters.map(c => <li><a href={c.url} aria-current={c === current ? 'page' : undefined}>{c.title}</a></li>)}</ol></nav><nav class="on-this-page" aria-label="In this chapter"><p class="eyebrow">In this chapter</p>{contents.map(h => <a href={'#'+h.slug}>{h.text}</a>)}</nav></aside>
<main id="main" tabindex="-1">
  <p class="eyebrow">{frontmatter.part} · Chapter {current.number}</p>
  <details class="mobile-course"><summary>All {v3Chapters.length} chapters</summary><ol>{v3Chapters.map(c => <li><a href={c.url} aria-current={c === current ? 'page' : undefined}>{c.title}</a></li>)}</ol></details>
  <article class="chapter-body">
    {questions ? sections.map(section => {
      if (section.kind === 'prose') return <Fragment set:html={section.content} />;
      if (section.content === 'investment-feedback') return <InvestmentFeedback />;
      if (section.content === 'change-impact-figure') return <ChangeImpactFigure />;
      if (section.content === 'intersection-model') return <QueueExperiment />;
      if (section.content === 'arrival-patterns') return <ArrivalPatterns />;
      if (section.content === 'intersection-structure') return <IntersectionStructure />;
      if (section.content === 'two-cycle-experiment') return <TwoCycleExperiment />;
      if (section.content === 'digital-thread') return <DigitalThread />;
      if (section.content === 'integrated-change') return <IntegratedChange />;
      if (section.content === 'release-readiness') return <ReleaseReadiness />;
      if (section.content === 'engineering-capability-flow') return <EngineeringCapabilityFlow />;
      if (section.content === 'evidence-handoffs') return <EvidenceHandoffs />;
      return <ChapterQuiz questions={questions} />;
    }) : <Content />}
  </article>
  <nav class="chapter-paging" aria-label="Previous and next chapters">{previous && <a rel="prev" href={previous.url}>← {previous.title}</a>}{next && <a rel="next" href={next.url}>{next.title} →</a>}</nav>
  <p class="publication-note">
    {!questions && 'Published after initial author review. This fictional teaching case is not physical validation. Interactive V3 tools remain in development. '}
    <a href={sourceUrl}>Chapter source{sourceState.dirty ? ' on main (preview changes are not included)' : ` at ${sourceState.revision.slice(0, 7)}`}</a>
  </p>
</main>
</div><footer class="reading-shell site-footer"><a href={base+'learn/'}>Learning path</a><AuthorAttribution /></footer>
<script>
  const sources = document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');
  if (sources.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'dark' });
    await document.fonts.ready;
    for (const source of sources) {
      const diagram = document.createElement('div');
      diagram.className = 'mermaid-view';
      const isSequence = source.textContent?.trim().startsWith('sequenceDiagram');
      if (isSequence) diagram.classList.add('sequence-view');
      diagram.setAttribute('role', 'img');
      diagram.setAttribute('aria-label', isSequence ? 'Sequence diagram. The preceding paragraph describes the events.' : 'Flowchart. The preceding paragraph describes the steps.');
      diagram.tabIndex = 0;
      diagram.textContent = source.textContent;
      source.before(diagram);
      try {
        await mermaid.run({ nodes: [diagram] });
        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = 'View diagram source';
        source.before(details);
        details.append(summary, source);
      } catch {
        diagram.remove(); // The readable source remains if rendering fails.
      }
    }
  }
</script>
</body></html>
<style is:global>
.chapter-body h1{font-size:clamp(2rem,4vw,3rem);line-height:1.15;margin:1rem 0 2rem;overflow-wrap:anywhere}
.chapter-body h2{margin-top:2.5rem}
.chapter-body table{display:block;overflow-x:auto;max-width:100%;border-collapse:collapse;font-size:.9rem;margin:1.5rem 0}
.chapter-body th,.chapter-body td{border:1px solid var(--rule);padding:.7rem;text-align:left;min-width:8rem}
.chapter-body code{overflow-wrap:anywhere}.chapter-body pre{overflow-x:auto}
.mermaid-view{overflow-x:auto;margin:1.5rem 0}.mermaid-view svg{display:block;max-width:100%;height:auto;margin:auto}
.mermaid-view.sequence-view svg{min-width:42rem}
.chapter-paging{display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between;margin:3rem 0}
.publication-note{font-size:.8rem;color:var(--muted)}
.course-sidebar li{margin:.6rem 0}.course-sidebar [aria-current=page]{color:var(--gold)}
</style>
