{
  "name": "executable-engineering-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "evidence": "tsx scripts/evidence.ts",
    "build": "node scripts/build.mjs",
    "check": "node scripts/verify.mjs",
    "predev": "node scripts/preflight.mjs",
    "preflight": "node scripts/preflight.mjs",
    "delivery": "node scripts/delivery.mjs",
    "test:delivery": "node --test scripts/delivery-tests.mjs",
    "verify:hosted": "node scripts/verify.mjs --release --checks=hosted",
    "ci:impact": "node scripts/ci-impact.mjs",
    "proposals": "tsx scripts/proposals.ts",
    "research:check": "node scripts/check-research-isolation.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "astro": "^7.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@astrojs/prism": "4.1.0"
  }
}
